# Server-only. Never prefix these with NEXT_PUBLIC_.
# Platform API that creates voice sessions (same service as the workspace app).
PLATFORM_URL=http://localhost:8000
# One of PLATFORM_API_KEYS on the Platform. Leave empty when Platform auth is disabled locally.
PLATFORM_API_KEY=
# Public demo agent slugs -> Platform agent UUIDs. Only these agents can be started from the landing page.
DEMO_AGENTS={"concierge":"00000000-0000-0000-0000-000000000000"}

# Public. Platform API the workspace pages (/agents) call from the browser. No key: same as the workspace app.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8000
# Public. Route the "Speak to it" orb calls. Leave empty for mic-preview mode (nothing is sent).
NEXT_PUBLIC_DEMO_TOKEN_ENDPOINT=/api/demo/session
# Origin of the workspace / call app. Empty = same origin (/call, /agents).
NEXT_PUBLIC_APP_URL=
# Public origin of the site, used for absolute share-image URLs (optional locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
